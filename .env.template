# Metadata Agent API Configuration
# ================================

# LLM Provider Selection
# Options: 'openai' (ohne B-API), 'b-api-openai', 'b-api-academiccloud', 'b-api-router'
METADATA_AGENT_LLM_PROVIDER=b-api-openai

# =========================================
# OpenAI Configuration (native OpenAI API)
# =========================================
# Leer lassen, bis ein echter Schlüssel da ist: /ready prüft nur, ob einer
# gesetzt ist – ein Platzhalter ließe den Dienst bereit melden.
OPENAI_API_KEY=

# Muss nicht OpenAI sein: jeder Endpunkt, der /chat/completions bedient und
# einen Bearer-Token annimmt (Azure, vLLM, eigenes Gateway), funktioniert.
METADATA_AGENT_OPENAI_API_BASE=https://api.openai.com/v1
METADATA_AGENT_OPENAI_MODEL=gpt-4o-mini

# Leer lassen = METADATA_AGENT_LLM_TEMPERATURE gilt auch hier.
METADATA_AGENT_OPENAI_TEMPERATURE=

# =========================================
# B-API Configuration (OpenEduHub)
# =========================================
# Shared API key for the B-API providers. Leer lassen, bis ein echter Schlüssel
# da ist (ein Platzhalter ließe /ready bestehen); im Modus forward nicht nötig.
B_API_KEY=

# Welcher Schlüssel die KI-Aufrufe trägt (ENV-PARAMETER.de.md, "B-API: Authentifizierung"):
#   auto    durchgereichter Authorization: Bearer der B-API (forwardApiKey), sonst B_API_KEY
#   forward nur durchgereichte Schlüssel; ohne Header 502 (LLM_AUTH_MISSING)
#   static  nur B_API_KEY (bisheriges Verhalten)
METADATA_AGENT_B_API_AUTH_MODE=auto
# GET /debug/auth (kommt ein Schlüssel an? maskiert) und GET /debug/dependencies
# (B-API, Textextraktion, Repository erreichbar? Schlüssel angenommen?) – nur zum
# Einrichten oder zur Fehlersuche einschalten:
METADATA_AGENT_DEBUG_ENDPOINTS=false

# B-API Base URL (Staging/Prod — Endpoint-Pfade werden automatisch abgeleitet)
# Staging: https://b-api.staging.openeduhub.net
# Prod:    https://b-api.prod.openeduhub.net
METADATA_AGENT_B_API_BASE_URL=https://b-api.staging.openeduhub.net

# B-API OpenAI (OpenAI-compatible endpoint via B-API)
# Wird automatisch aus B_API_BASE_URL abgeleitet, kann überschrieben werden:
# METADATA_AGENT_B_API_OPENAI_BASE=https://b-api.staging.openeduhub.net/api/v1/llm/openai
METADATA_AGENT_B_API_OPENAI_MODEL=gpt-6-luna

# Nur für GPT-5/GPT-6 und o-Modelle — gpt-4.1-mini & Co. lehnen beide mit
# 400 ab und bekommen sie deshalb gar nicht erst gesendet.
# verbosity: low | medium | high
# reasoning_effort: none | low | medium | high  ('minimal' wird abgelehnt)
# 'none' ist ~40% schneller, verlor im Test aber Veranstaltungsdaten.
# Leer = der Parameter wird nicht gesendet; ein anderer Wert verhindert den Start.
METADATA_AGENT_LLM_VERBOSITY=low
METADATA_AGENT_LLM_REASONING_EFFORT=low

# B-API AcademicCloud (AcademicCloud endpoint via B-API)
# 'deepseek-r1' antwortete mit 404 Model Not Found und ist deshalb nicht mehr
# der Default. Gemessen am 12.08.2026 lieferte 'deepseek-v4-flash' die
# gleichmaessigste Latenz der AcademicCloud-Modelle.
# METADATA_AGENT_B_API_ACADEMICCLOUD_BASE=https://b-api.staging.openeduhub.net/api/v1/llm/academiccloud
METADATA_AGENT_B_API_ACADEMICCLOUD_MODEL=deepseek-v4-flash

# B-API Router (llm_provider=b-api-router, ENV-PARAMETER.de.md "B-API: Routing").
# provider/modell geht ohne Route; sonst erst die Route anlegen, dann den Namen setzen.
# METADATA_AGENT_B_API_ROUTER_BASE=https://b-api.staging.openeduhub.net/api/v1/llm/router
METADATA_AGENT_B_API_ROUTER_MODEL=openai/gpt-6-luna
# Parameterfamilie der Route: auto (am Modellnamen), reasoning (GPT-5/6), classic (alle anderen)
METADATA_AGENT_LLM_REQUEST_STYLE=auto
# Nur Router + classic: reasoning_effort fuer denkende Modelle (qwen3.6: none); leer = nicht senden
METADATA_AGENT_B_API_ROUTER_REASONING_EFFORT=
# true: immer neu fragen statt Antworten aus dem B-API-Cache
METADATA_AGENT_B_API_IGNORE_CACHE=false
# Cache-Haltepunkt nach dem Seitentext (OpenAI-Prompt-Cache): auto (nur gpt-6-Modelle), on, off
METADATA_AGENT_LLM_CACHE_BREAKPOINT=auto

# =========================================
# General LLM Settings
# =========================================
METADATA_AGENT_LLM_TEMPERATURE=0.3
METADATA_AGENT_LLM_MAX_TOKENS=2000
# Attempts per LLM call (1 = no repetition) and extra calls for an invalid
# field value; at least 1.
METADATA_AGENT_LLM_MAX_RETRIES=3
# Models a request may name in llm_model, comma-separated; empty: any. The
# provider's default model is always allowed.
# METADATA_AGENT_ALLOWED_LLM_MODELS=
METADATA_AGENT_LLM_RETRY_DELAY=1.0

# =========================================
# Durchsatzgrenzen des LLM-Gateways
# =========================================
# Gelten prozessweit, nicht pro Request; jeder Provider hat ein eigenes Budget.
# Leer = Default des Providers: b-api-openai und openai 20 gleichzeitig ohne
# Ratenbegrenzung, b-api-academiccloud 2 gleichzeitig / 2 pro Sekunde.
# Gesetzte Werte gelten fuer jeden Provider — ueber 2 also auch fuer
# AcademicCloud ueber dessen gemessene Grenze hinaus.
#
# AcademicCloud weist einen dritten parallelen Request sofort mit 429 ab, und
# zwar ohne retry-after — die Grenze muss der Client einhalten. Antwortet das
# Gateway auch auf b-api-openai mit 429, hier ein niedrigeres Limit setzen.
#
# 0 bei REQUESTS_PER_SECOND schaltet die Ratenbegrenzung ab. Negative Werte
# und weniger als 1 gleichzeitiger Aufruf verhindern den Start.
METADATA_AGENT_LLM_MAX_CONCURRENT_REQUESTS=
METADATA_AGENT_LLM_MAX_REQUESTS_PER_SECOND=

# =========================================
# Worker Settings
# =========================================
# Breite des parallelen Feld-Fan-outs; gilt fuer /generate ohne max_workers
# (auf 1-20 begrenzt). Wird zusaetzlich auf das Durchsatzlimit des Providers
# gedeckelt — bei AcademicCloud laufen also 2 Worker, egal was hier steht.
METADATA_AGENT_DEFAULT_MAX_WORKERS=20
# Timeout je KI-Aufruf in Sekunden (Puffer unter METADATA_AGENT_GENERATE_TIMEOUT)
METADATA_AGENT_REQUEST_TIMEOUT=90
# Obergrenze fuer ein ganzes /generate in Sekunden; danach 504 GENERATION_TIMEOUT
# (unter dem Ingress-Timeout von 320 s, ueber METADATA_AGENT_REQUEST_TIMEOUT;
# ein B-API-Proxy oder edu-sharing davor braucht mindestens ~310 s Timeout)
METADATA_AGENT_GENERATE_TIMEOUT=300
# Obergrenze fuer ein ganzes /upload bzw. /nodes in Sekunden; danach 504
# UPLOAD_TIMEOUT (+ Verwerfen + preStop unter dem Ingress-Timeout von 320 s)
METADATA_AGENT_UPLOAD_TIMEOUT=100

# =========================================
# CORS and Screenshots
# =========================================
# Allowed origins, comma-separated, or * for all
# METADATA_AGENT_CORS_ORIGINS=*
# Screenshots are always captured locally (Chromium in the container)
# METADATA_AGENT_SCREENSHOT_WIDTH=1920
# METADATA_AGENT_SCREENSHOT_HEIGHT=1080
# METADATA_AGENT_SCREENSHOT_FORMAT=png
# METADATA_AGENT_SCREENSHOT_FULL_PAGE=false
# METADATA_AGENT_SCREENSHOT_DELAY=2000

# =========================================
# Input Source Settings
# =========================================
# Repository URL (for NodeID input source and upload)
# Staging: https://repository.staging.openeduhub.net/edu-sharing/rest
# Prod:    https://redaktion.openeduhub.net/edu-sharing/rest
METADATA_AGENT_REPOSITORY_URL=https://repository.staging.openeduhub.net/edu-sharing/rest

# Textextraktion (URL-Eingaben) und Geocoder: mit einem B-API-Provider ueber
# die Pfade der B-API (immer die der gewaehlten B-API, mit demselben Schluessel
# wie die LLM-Aufrufe), sonst passend zur Repository-Adresse.
# auto (Standard), proxy oder direct
# METADATA_AGENT_B_API_SERVICES=auto
# Nur um eine Textextraktion selbst zu benennen (leer = wie oben gewaehlt)
# METADATA_AGENT_TEXT_EXTRACTION_API_URL=

# WLO Repository Inbox ID (where new upload nodes are created)
METADATA_AGENT_WLO_INBOX_ID=21144164-30c0-4c01-ae16-264452197063

# =========================================
# Repository Upload (WLO edu-sharing)
# =========================================
# Required for /upload endpoint
# Get credentials from WLO admin
WLO_GUEST_USERNAME=
WLO_GUEST_PASSWORD=
# Without them /ready answers 503. A deployment that only generates (as with
# 2.1.1) sets this to false: ready without the credentials, /upload and /nodes
# answer 503.
# METADATA_AGENT_REQUIRE_REPOSITORY=true

# =========================================
# Betrieb: Logs, interner Port
# =========================================
# text (wie bisher) oder json (ein Objekt je Zeile, mit service, trace_id, span_id)
METADATA_AGENT_LOG_FORMAT=text
METADATA_AGENT_LOG_LEVEL=INFO
# Feld "service" der JSON-Logzeilen (Dienst-ID)
# METADATA_AGENT_SERVICE_NAME=metadata-agent
# Zweiter, interner Port fuer /health, /ready und /metrics (leer = aus)
# METADATA_AGENT_INTERNAL_PORT=9000
# Größter Request-Body in Bytes (darüber 413), Default 20 MB
# METADATA_AGENT_MAX_REQUEST_BYTES=20971520
# Nur wenn die Plattform dem Prozess nach SIGTERM nicht 320 s lässt
# (stop_grace_period, --stop-timeout; das Helm-Chart setzt den Wert selbst):
# Die Startwarnungen vergleichen GENERATE_TIMEOUT und UPLOAD_TIMEOUT damit.
# METADATA_AGENT_GRACE_PERIOD_SECONDS=320
